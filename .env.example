NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_TOKEN=replace-with-a-second-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ha_sar

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_WEBHOOK_SECRET=

# Optional: pin an already-uploaded SAR Lobe. If blank, the app uploads the
# bundled skills/ha-sar-lobe once and remembers the id/version in PostgreSQL.
OPENAI_SKILL_ID=
OPENAI_SKILL_VERSION=

# Google Drive OAuth 2.0 (personal Gmail My Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_NAME=HA-SAR-Results

# Email delivery (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourname@gmail.com
SMTP_PASS=
MAIL_FROM=HA SAR Reviewer <yourname@gmail.com>

# Limits and retention
MAX_FILE_MB=15
RESULT_TTL_DAYS=7
POLL_INTERVAL_SECONDS=30
DELIVERY_RETRY_SECONDS=300
